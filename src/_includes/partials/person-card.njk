{#
  One person on the Executive Board page.
  Expects a `person` variable (an item from `collections.board`).

  Layout follows the CTrees team pattern: circular grayscale headshot, bold
  name, muted role underneath, and the bio tucked behind a disclosure so the
  grid stays scannable. Built on <details>/<summary> so it works with the
  keyboard and without JavaScript.

  Everything degrades: no photo shows a monogram, no bio drops the disclosure
  entirely rather than offering an arrow that opens nothing.

  Note: the shared markup is captured with {% set %}…{% endset %} rather than a
  macro. Nunjucks macros do not inherit the surrounding loop variable, so
  `person` reads as undefined inside one.
#}

{% set hasDetail = person.data.bio or person.data.email or person.data.pronunciation %}
{% set displayName = person.data.name or "To be announced" %}

{% set cardFace %}
  {% if person.data.photo %}
    <img
      class="person__photo"
      src="{{ person.data.photo }}"
      alt="{{ displayName }}"
      width="130"
      height="130"
      loading="lazy"
    />
  {% else %}
    <span class="person__photo person__photo--empty" role="img"
          aria-label="{{ labels.noPhotoPrefix }} {{ displayName }}">
      {% include "partials/avatar-icon.njk" %}
    </span>
  {% endif %}

  <span class="person__name">{{ displayName }}</span>
  <span class="person__role{% if person.data.isAdvisor %} person__role--advisor{% endif %}">
    {{ person.data.role }}
  </span>
  {% if person.data.program %}
    <span class="person__program">{{ person.data.program }}</span>
  {% endif %}
{% endset %}

{% if hasDetail %}
  <details class="person">
    <summary class="person__summary">
      {{ cardFace | safe }}
      <span class="person__toggle">
        <span class="person__toggle-text">{{ boardPage.readBioLabel }}</span>
        <svg class="person__caret" viewBox="0 0 20 13" aria-hidden="true">
          <path d="M17.65 0L10 7.63333L2.35 0L0 2.35L10 12.35L20 2.35L17.65 0Z" />
        </svg>
      </span>
    </summary>

    <div class="person__panel">
      {% if person.data.pronunciation %}
        <p class="person__pron">
          <span class="person__pron-label">{{ boardPage.pronunciationLabel }}</span>
          {{ person.data.pronunciation }}
        </p>
      {% endif %}

      {% if person.data.bio %}
        <div class="person__bio">{{ person.data.bio | md | safe }}</div>
      {% endif %}

      {% if person.data.email or person.data.officeHours %}
        <p class="person__contact">
          {% if person.data.email %}
            <a href="mailto:{{ person.data.email }}">{{ person.data.email }}</a><br />
          {% endif %}
          {% if person.data.officeHours %}
            <span>Office hours: {{ person.data.officeHours }}</span>
          {% endif %}
        </p>
      {% endif %}

      {#
        Shown only once a profile address exists. An icon with no link behind it
        is worse than no icon: it looks like something to press and isn't.
      #}
      {% if person.data.linkedin %}
        <p class="person__social">
          <a
            class="person__social-link"
            href="{{ person.data.linkedin }}"
            target="_blank"
            rel="noopener"
            aria-label="{{ displayName }} {{ labels.socialLinkedinSuffix }}"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM9 9h3.8v1.64h.05c.53-1 1.83-2.06 3.76-2.06 4.02 0 4.76 2.65 4.76 6.09V21h-4v-5.4c0-1.29-.02-2.95-1.8-2.95-1.8 0-2.07 1.4-2.07 2.85V21H9z"/></svg>
          </a>
        </p>
      {% endif %}
    </div>
  </details>
{% else %}
  <article class="person person--static">
    <div class="person__summary">{{ cardFace | safe }}</div>
  </article>
{% endif %}
