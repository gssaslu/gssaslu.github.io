{#
  A group is a label with children; everything else is a plain link. Written
  as data rather than as markup so adding a page is one line here and nothing
  else, which is the same bargain the rest of the site makes.
#}
{% set nav = [
  { url: "/",            label: "Home" },
  { url: "/board/",      label: "Executive Board" },
  { url: "/funding/",    label: "Funding & Awards" },
  { url: "/membership/", label: "Membership" },
  { label: "News & Events", children: [
    { url: "/news/",   label: "Announcements" },
    { url: "/events/", label: "Events" }
  ] }
] %}

<aside class="sidebar">
  <canvas class="sidebar__canvas" id="network" aria-hidden="true"></canvas>

  <div class="sidebar__inner">
    <header>
      <a class="sidebar__brand" href="/">
        <img
          class="sidebar__logo"
          src="/assets/img/gssa_logo.png"
          alt="{{ site.orgName }}"
          width="700"
          height="408"
        />
      </a>
      {# On the home page this name is the page's h1; every other page has one
         of its own, so there it is plain text. #}
      {% if page.url == "/" %}
        <h1 class="sidebar__orgname">{{ site.orgName }}</h1>
      {% else %}
        <p class="sidebar__orgname">{{ site.orgName }}</p>
      {% endif %}
      <p class="sidebar__institution">{{ site.institution }}</p>

      {% if site.social.instagram or site.social.linkedin or site.social.github %}
        <div class="sidebar__social">
          {% if site.social.instagram %}
            <a href="{{ site.social.instagram }}" aria-label="{{ labels.socialInstagram }}">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zm0 5.68a4.16 4.16 0 100 8.32 4.16 4.16 0 000-8.32zm0 6.86a2.7 2.7 0 110-5.4 2.7 2.7 0 010 5.4zm5.3-7.02a.97.97 0 11-1.94 0 .97.97 0 011.94 0z"/></svg>
            </a>
          {% endif %}
          {% if site.social.linkedin %}
            <a href="{{ site.social.linkedin }}" aria-label="{{ labels.socialLinkedin }}">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM9 9h3.8v1.64h.05c.53-1 1.83-2.06 3.76-2.06 4.02 0 4.76 2.65 4.76 6.09V21h-4v-5.4c0-1.29-.02-2.95-1.8-2.95-1.8 0-2.07 1.4-2.07 2.85V21H9z"/></svg>
            </a>
          {% endif %}
          {% if site.social.github %}
            <a href="{{ site.social.github }}" aria-label="{{ labels.socialGithub }}">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 00.5 12a11.5 11.5 0 007.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.35-1.29-1.71-1.29-1.71-1.06-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.75.4-1.27.73-1.56-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 015.8 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.26 5.7.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0023.5 12 11.5 11.5 0 0012 .5z"/></svg>
            </a>
          {% endif %}
        </div>
      {% endif %}
    </header>

    <nav class="sidebar__nav" aria-label="{{ labels.navLabel }}">
      {% for item in nav %}
        {% if item.children %}
          {#
            <details> rather than a script: the browser already owns the open
            and closed states, the keyboard behaviour and the accessible name.
            Nothing here depends on JavaScript having loaded.

            It starts open when the page you are on lives inside the group —
            otherwise landing on /events/ would show a collapsed group with the
            current page hidden inside it.
          #}
          <details class="sidebar__group" {% if item.children | holdsCurrent(page.url) %}open{% endif %}>
            <summary class="sidebar__link sidebar__group-toggle">
              <span>{{ item.label }}</span>
              <svg class="sidebar__caret" viewBox="0 0 20 13" aria-hidden="true">
                <path d="M17.65 0L10 7.63333L2.35 0L0 2.35L10 12.35L20 2.35L17.65 0Z" />
              </svg>
            </summary>

            <div class="sidebar__sub">
              {% for child in item.children %}
                <a
                  class="sidebar__link sidebar__link--sub"
                  href="{{ child.url }}"
                  {% if page.url == child.url or page.url.startsWith(child.url) and child.url != "/" %}aria-current="page"{% endif %}
                >{{ child.label }}</a>
              {% endfor %}
            </div>
          </details>
        {% else %}
          <a
            class="sidebar__link"
            href="{{ item.url }}"
            {% if page.url == item.url %}aria-current="page"{% endif %}
          >{{ item.label }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <div class="sidebar__meta">
      <p>{{ site.institution }}</p>
      <p>{{ site.center.address }}</p>
      {% if site.contactEmail %}
        <p><a href="mailto:{{ site.contactEmail }}">{{ site.contactEmail }}</a></p>
      {% endif %}
    </div>
  </div>
</aside>
