{#
  Renders one funding opportunity. Expects an `award` variable.

  The disclosure table below is not decoration: Bylaws Art. VIII 8.13 requires
  eligibility, quantity, application method, deadline, decision timeline and
  selection criteria to be published BEFORE applications open. Fields that are
  still blank render as an explicit "To be published" rather than being hidden,
  so it is visible at a glance what the board still owes applicants.
#}
{% set statusLabel = {
  open: "Open",
  upcoming: "Coming soon",
  closed: "Closed"
} %}

<article class="award award--{{ award.data.status or 'upcoming' }}">
  <div class="award__head">
    <h3>{{ award.data.title }}</h3>
    <span class="badge badge--{{ award.data.status or 'upcoming' }}">
      {{ statusLabel[award.data.status] or "Coming soon" }}
    </span>
  </div>

  {% if award.data.body %}
    <div class="award__summary">{{ award.data.body | md | safe }}</div>
  {% endif %}

  <div class="table-scroll">
    <table class="disclosure">
      <caption class="visually-hidden">
        Published terms for {{ award.data.title }}
      </caption>
      <tbody>
        <tr>
          <th scope="row">Eligibility</th>
          {% if award.data.eligibility %}
            <td>{{ award.data.eligibility }}</td>
          {% else %}
            <td class="pending">To be published before applications open</td>
          {% endif %}
        </tr>
        <tr>
          <th scope="row">Quantity available</th>
          {% if award.data.quantity %}
            <td>{{ award.data.quantity }}</td>
          {% else %}
            <td class="pending">To be published before applications open</td>
          {% endif %}
        </tr>
        <tr>
          <th scope="row">How to apply</th>
          {% if award.data.applicationMethod %}
            <td>{{ award.data.applicationMethod }}</td>
          {% else %}
            <td class="pending">To be published before applications open</td>
          {% endif %}
        </tr>
        <tr>
          <th scope="row">Deadline</th>
          {% if award.data.deadline %}
            <td>{{ award.data.deadline }}</td>
          {% else %}
            <td class="pending">To be published before applications open</td>
          {% endif %}
        </tr>
        <tr>
          <th scope="row">Decision timeline</th>
          {% if award.data.decisionTimeline %}
            <td>{{ award.data.decisionTimeline }}</td>
          {% else %}
            <td class="pending">To be published before applications open</td>
          {% endif %}
        </tr>
        <tr>
          <th scope="row">Selection criteria</th>
          {% if award.data.selectionCriteria %}
            <td>{{ award.data.selectionCriteria }}</td>
          {% else %}
            <td class="pending">To be published before applications open</td>
          {% endif %}
        </tr>
      </tbody>
    </table>
  </div>

  {% if award.data.status == "open" and award.data.applyUrl %}
    <p style="margin-top: 1.25rem; margin-bottom: 0;">
      <a class="btn btn--primary" href="{{ award.data.applyUrl }}">Apply now</a>
    </p>
  {% endif %}
</article>
