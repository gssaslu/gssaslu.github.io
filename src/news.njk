---
layout: base.njk
permalink: /news/
title: News
pageDescription: >-
  Every GSSA announcement, newest first — meetings, workshops, guest speakers
  and funding opportunities.
---

<div class="page-head">
  <h1>{{ home.newsHeading }}</h1>
  <p class="page-head__sub">Every announcement, newest first.</p>
</div>

<section>
  {% if collections.news | length %}
    <ul class="news">
      {% for item in collections.news %}
        <li class="news__item">
          <div class="news__date">
            <time datetime="{{ item.date | isoDate }}">{{ item.date | newsDate }}</time>
          </div>
          <div>
            <h3 class="news__title">{{ item.data.title }}</h3>
            <div class="news__body">{{ item.data.body | md | safe }}</div>

            {% if item.data.image %}
              <img
                class="news__img"
                src="{{ item.data.image }}"
                alt="{{ item.data.imageAlt or item.data.title }}"
                loading="lazy"
              />
            {% endif %}

            {% if item.data.links | length %}
              <div class="news__links">
                {% for link in item.data.links %}
                  <a href="{{ link.url }}">{{ link.label }}</a>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p>{{ home.newsEmpty }}</p>
  {% endif %}
</section>
