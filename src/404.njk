---
layout: base.njk
permalink: /404.html
noindex: true
eleventyComputed:
  title: "{{ notFound.title }}"
  pageDescription: "{{ notFound.body }}"
---
{#
  Every word here is in the CMS, the same as any other page — a 404 is the one
  page a visitor reads when something has already gone wrong, so it should not
  be the one page officers cannot fix.
#}

<div class="page-head">
  {% if notFound.eyebrow %}
    <span class="eyebrow">{{ notFound.eyebrow }}</span>
  {% endif %}
  <h1>{{ notFound.title }}</h1>
  {% if notFound.body %}
    <p class="page-head__sub">{{ notFound.body }}</p>
  {% endif %}
</div>

<div class="btn-row">
  {% if notFound.primaryLabel %}
    <a class="btn btn--primary" href="{{ notFound.primaryUrl or '/' }}">
      {{ notFound.primaryLabel }}
    </a>
  {% endif %}
  {% if notFound.secondaryLabel %}
    <a class="btn btn--ghost" href="{{ notFound.secondaryUrl or '/' }}">
      {{ notFound.secondaryLabel }}
    </a>
  {% endif %}
</div>
