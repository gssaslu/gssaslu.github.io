---
layout: base.njk
permalink: /funding/
title: Funding & Awards
pageDescription: >-
  Conference vouchers, travel assistance and other limited opportunities
  available to GSSA members, with eligibility and selection criteria published
  before applications open.
---

<div class="page-head">
  <h1>{{ fundingPage.title }}</h1>
  <p class="page-head__sub">{{ fundingPage.intro }}</p>
</div>

{% if fundingPage.policyBody %}
  <div class="callout callout--info">
    <h3>{{ fundingPage.policyHeading }}</h3>
    {{ fundingPage.policyBody | md | safe }}
    {% if fundingPage.policyReference %}
      <p class="ref">{{ fundingPage.policyReference }}</p>
    {% endif %}
  </div>
{% endif %}

<section class="section">
  <div class="section__head"><h2>{{ fundingPage.awardsHeading }}</h2></div>

  {% if collections.awards | length %}
    {% for award in collections.awards %}
      {% include "partials/award-card.njk" %}
    {% endfor %}
  {% else %}
    <p>{{ fundingPage.awardsEmpty }}</p>
  {% endif %}
</section>

{% if collections.recipients | length %}
  <section class="section">
    <div class="section__head">
      <h2>{{ fundingPage.recipientsHeading }}</h2>
      {% if fundingPage.recipientsNote %}
        <p class="section__note">{{ fundingPage.recipientsNote }}</p>
      {% endif %}
    </div>

    <div class="recipients">
      {% for person in collections.recipients %}
        <article class="recipient">
          {% if person.data.photo %}
            <img
              class="recipient__photo"
              src="{{ person.data.photo }}"
              alt="{{ person.data.name }}"
              width="92"
              height="92"
              loading="lazy"
            />
          {% else %}
            <span class="recipient__photo recipient__photo--empty" role="img"
                  aria-label="{{ labels.noPhotoPrefix }} {{ person.data.name }}">
              {% include "partials/avatar-icon.njk" %}
            </span>
          {% endif %}
          <h3 class="recipient__name">{{ person.data.name }}</h3>
          <p class="recipient__award">
            {{ person.data.award }}{% if person.data.term %} · {{ person.data.term }}{% endif %}
          </p>
          {% if person.data.note %}
            <p class="recipient__note">{{ person.data.note }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </section>
{% endif %}

{% if fundingPage.external | length %}
  <section class="section">
    <div class="section__head">
      <h2>{{ fundingPage.externalHeading }}</h2>
      {% if fundingPage.externalNote %}
        <p class="section__note">{{ fundingPage.externalNote }}</p>
      {% endif %}
    </div>

    {#
      The whole card is the link — there is nothing else on it to click, so a
      separate "apply" button would only be a second way to do the same thing.
      These all leave the site, hence the new tab and the outward arrow.
    #}
    <div class="grid">
      {% for item in fundingPage.external %}
        <a
          class="feature feature--link"
          href="{{ item.url }}"
          target="_blank"
          rel="noopener"
        >
          <h3>
            {{ item.title }}
            <svg class="feature__out" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3zM19 19H5V5h6V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-6h-2z" />
            </svg>
          </h3>
          <p>{{ item.description }}</p>
        </a>
      {% endfor %}
    </div>
  </section>
{% endif %}
